#version 450

// RMSNorm over one vector: out[i] = x[i] * rsqrt(mean(x^2) + eps) * w[i]. One workgroup does the
// whole vector (strided reduction), mirroring the CUDA rmsnormKernel.

layout(local_size_x = 256) in;

layout(std430, binding = 0) writeonly buffer OBuf { float o[]; };
layout(std430, binding = 1) readonly buffer XBuf { float x[]; };
layout(std430, binding = 2) readonly buffer WBuf { float w[]; };

layout(push_constant) uniform PC {
  uint n;
  float eps;
} pc;

shared float red[256];
shared float scaleS;

void main() {
  uint tid = gl_LocalInvocationID.x;
  float local = 0.0;
  for (uint i = tid; i < pc.n; i += 256u) local += x[i] * x[i];
  red[tid] = local;
  barrier();
  for (uint s = 128u; s > 0u; s >>= 1u) {
    if (tid < s) red[tid] += red[tid + s];
    barrier();
  }
  if (tid == 0u) scaleS = inversesqrt(red[0] / float(pc.n) + pc.eps);
  barrier();
  float sc = scaleS;
  for (uint i = tid; i < pc.n; i += 256u) o[i] = x[i] * sc * w[i];
}
