#version 450

// Copy a kvDim vector into the KV cache slot for (layer, pos):
//   cache[(layer*maxSeq + pos)*kvDim + i] = src[i].
// Mirrors kvStoreKernel.

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer CBuf { float cache[]; };
layout(std430, binding = 1) readonly buffer SBuf { float src[]; };

layout(push_constant) uniform PC {
  uint layer;
  uint pos;
  uint maxSeq;
  uint kvDim;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i < pc.kvDim) cache[(pc.layer * pc.maxSeq + pc.pos) * pc.kvDim + i] = src[i];
}
