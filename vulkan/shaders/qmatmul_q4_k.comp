#version 450

// Q4_K quantized GEMV. Q4_K packs 256 elements per super-block in 144 bytes:
//   [ d(2) | dmin(2) | scales(12) | qs(128) ]
// d, dmin are fp16; the 12 scale bytes hold eight 6-bit (scale, min) pairs (getScaleMinK4, verbatim
// from ggml); qs holds 256 4-bit quants. Dequant: value = d*scale*nibble - dmin*min. Byte-for-byte
// the CUDA qmatmulQ4_KKernel / CPU reference layout.
//
// One WORKGROUP computes one output row; the 256 lanes split the elements and tree-reduce the
// partials in shared memory. The tree reduction keeps fp32 accumulation error low enough that the
// full-model logits match the CPU runtime, not just the argmax (a single-thread sequential sum over
// ~2048 terms drifts too far after 22 layers).

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer WBuf { uint W[]; };
layout(std430, binding = 1) readonly buffer XBuf { float X[]; };
layout(std430, binding = 2) writeonly buffer OBuf { float O[]; };

layout(push_constant) uniform PC {
  uint rows;
  uint cols;
} pc;

uint gb(uint a) { return (W[a >> 2u] >> ((a & 3u) * 8u)) & 0xFFu; }

// 6-bit (scale, min) unpack for sub-block j from the 12 scale bytes based at address s.
void getScaleMinK4(uint j, uint s, out uint sc, out uint m) {
  if (j < 4u) {
    sc = gb(s + j) & 63u;
    m = gb(s + j + 4u) & 63u;
  } else {
    sc = (gb(s + j + 4u) & 0xFu) | ((gb(s + j - 4u) >> 6u) << 4u);
    m = (gb(s + j + 4u) >> 4u) | ((gb(s + j) >> 6u) << 4u);
  }
}

shared float red[256];

void main() {
  uint row = gl_WorkGroupID.x;
  if (row >= pc.rows) return;
  uint tid = gl_LocalInvocationID.x;

  uint nSB = pc.cols / 256u;
  uint rowBytes = nSB * 144u;
  uint base = row * rowBytes;

  float sum = 0.0;
  for (uint e = tid; e < pc.cols; e += 256u) {
    uint sb = e / 256u, i = e % 256u;  // super-block and element-within-super-block
    uint blk = base + sb * 144u;
    float d = unpackHalf2x16(gb(blk) | (gb(blk + 1u) << 8u)).x;
    float dmin = unpackHalf2x16(gb(blk + 2u) | (gb(blk + 3u) << 8u)).x;
    uint j = i >> 5u;  // sub-block index
    uint sc, m;
    getScaleMinK4(j, blk + 4u, sc, m);
    uint chunk = i / 64u, local = i % 64u;
    uint qbyte = gb(blk + 16u + chunk * 32u + (local & 31u));
    uint nib = (local < 32u) ? (qbyte & 0xFu) : (qbyte >> 4u);
    sum += (d * float(sc) * float(nib) - dmin * float(m)) * X[e];
  }
  red[tid] = sum;
  barrier();
  for (uint s = 128u; s > 0u; s >>= 1u) {
    if (tid < s) red[tid] += red[tid + s];
    barrier();
  }
  if (tid == 0u) O[row] = red[0];
}
