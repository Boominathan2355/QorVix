#version 450

// SwiGLU: out[i] = silu(gate[i]) * up[i], silu(z) = z * sigmoid(z). Mirrors the CUDA swigluKernel.

layout(local_size_x = 256) in;

layout(std430, binding = 0) writeonly buffer OBuf { float o[]; };
layout(std430, binding = 1) readonly buffer GBuf { float g[]; };
layout(std430, binding = 2) readonly buffer UBuf { float u[]; };

layout(push_constant) uniform PC {
  uint n;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
  float gv = g[i];
  o[i] = (gv / (1.0 + exp(-gv))) * u[i];
}
